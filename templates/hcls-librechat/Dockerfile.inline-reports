# syntax=docker/dockerfile:1.7
# Presentation and skill update only; preserve the current scientific executor.
ARG WORKBENCH_BASE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/lc@sha256:f125725950ae56927b630e4289bda2370491f52993e4a7c977bca8207e01cbd6
FROM ${WORKBENCH_BASE}
USER root
COPY skills/scientific-ai/manifest.json /app/skill/manifest.json
RUN --mount=type=bind,source=templates/hcls-librechat,target=/tmp/client,ro \
    --mount=type=bind,source=skills/scientific-ai/md-precheck,target=/tmp/precheck,ro \
    cp /tmp/client/WorkspaceInlineCode.tsx /tmp/client/WorkspaceReportPreview.test.tsx /app/client/src/components/ \
 && cp /tmp/precheck/SKILL.md /app/skill/md-precheck/SKILL.md \
 && cd /app/client \
 && NODE_ENV=test /app/node_modules/.bin/jest --runInBand --watch=false --coverage=false --forceExit \
    src/components/WorkspaceReportPreview.test.tsx src/components/ScientificClientUpdate.test.tsx \
 && TYPESCRIPT_MODULE=/app/node_modules/typescript node --test \
    /tmp/client/demos/workspace-inline-code.test.cjs /tmp/client/demos/workspace-highlighted-code.test.cjs \
 && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 /app/node_modules/.bin/vite build --logLevel error \
 && node /opt/hcls-librechat/brand-client.mjs /app/client/dist /opt/hcls-librechat/assets --verify
ARG HCLS_IMAGE_REVISION=unknown
LABEL org.opencontainers.image.revision="${HCLS_IMAGE_REVISION}" \
      ai.nebius.scientific.skills.version="2026.10.19.1" \
      ai.nebius.scientific.release="inline-reports-20261019"
