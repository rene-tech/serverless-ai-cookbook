# syntax=docker/dockerfile:1.7
# Add isolated CRISPR CPU tools to the current AF3 + BioEmu2 release.
ARG WORKBENCH_BASE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/lc@sha256:3a3357728e0e613c5099a5fe40021dfb5f686c525a184489d46c01db11c32e9b
FROM ${WORKBENCH_BASE}
COPY --from=ghcr.io/astral-sh/uv@sha256:240fb85ab0f263ef12f492d8476aa3a2e4e1e333f7d67fbdd923d00a506a516a /uv /tmp/crispr-uv
COPY templates/hcls-librechat/crispr/requirements-core.lock templates/hcls-librechat/crispr/requirements-pegg.lock templates/hcls-librechat/crispr/NOTICE.md /opt/crispr-runtime/
RUN apt-get update && apt-get install -y --no-install-recommends bowtie=1.3.1-1+b1 libgomp1 \
 && UV_PYTHON_INSTALL_DIR=/opt/crispr-python /tmp/crispr-uv python install 3.10.20 \
 && UV_PYTHON_INSTALL_DIR=/opt/crispr-python /tmp/crispr-uv venv --python 3.10.20 /opt/crispr-core \
 && UV_PYTHON_INSTALL_DIR=/opt/crispr-python /tmp/crispr-uv venv --python 3.10.20 /opt/crispr-pegg \
 && /tmp/crispr-uv pip sync --python /opt/crispr-core/bin/python --require-hashes /opt/crispr-runtime/requirements-core.lock \
 && /tmp/crispr-uv pip sync --python /opt/crispr-pegg/bin/python --require-hashes /opt/crispr-runtime/requirements-pegg.lock \
 && apt-get clean \
 && rm /tmp/crispr-uv
RUN --mount=type=bind,source=skills/scientific-ai,target=/tmp/core-skills,ro \
    python3 /tmp/core-skills/bundle.py verify \
 && python3 /tmp/core-skills/bundle.py build --output /tmp/crispr-skill-bundle \
 && tar -xzf /tmp/crispr-skill-bundle/scientific-ai-skills-2026.10.22.4.tar.gz --strip-components=1 -C /app/skill
COPY templates/hcls-librechat/crispr/test_workflow.py /opt/crispr-runtime/test_workflow.py
RUN --mount=type=bind,source=templates/hcls-librechat,target=/tmp/workbench,ro \
    node /tmp/workbench/scripts/test-skills-installed.cjs \
 && OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 /opt/crispr-core/bin/python -m pytest -q /opt/crispr-runtime/test_workflow.py
ARG HCLS_IMAGE_REVISION=unknown
LABEL org.opencontainers.image.revision="${HCLS_IMAGE_REVISION}" \
      org.opencontainers.image.source="https://github.com/rene-tech/serverless-ai-cookbook" \
      ai.nebius.scientific.skills.version="2026.10.22.4" \
      ai.nebius.scientific.release="crispr-workbench-20261022"
