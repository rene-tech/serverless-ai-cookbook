# syntax=docker/dockerfile:1.7
# Consolidated validated client fixes, report helpers and current MD guidance.
# Preserve its clients, runtimes, supervisor, provider and complete skill set.
# Build with --build-context scientific-skills=./skills/scientific-ai.
ARG WORKBENCH_BASE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/lc@sha256:be5adc6c39b5ef7909d382d7122e56c79336edf11b1a94342df05f4765ea08f6
FROM ${WORKBENCH_BASE}
# Token Factory /v1/models advertises Kimi K3 context_length=1024000.
ENV SCIENTIFIC_CHAT_MAX_CONTEXT_TOKENS=1024000
USER root
# Copy only declared source files in one layer; keep the inherited scientific runtimes.
RUN --mount=type=bind,source=templates/hcls-librechat,target=/tmp/client,ro \
    --mount=type=bind,source=life-science/bionemo-librechat,target=/tmp/viewer,ro \
    --mount=type=bind,source=plugins/cbioportal-research,target=/tmp/cbioportal,ro python3 - <<'PYINSTALL'
import pathlib, py_compile, shutil
source = pathlib.Path('/tmp/client')
for name in ('scientific_study.py', 'scientific_study_schema.py', 'structure-analysis.py',
             'scientific_protein_preparation.py', 'native_md_artifacts.py', 'native_md_preview.py',
             'native_md_report.py', 'scientific_starter.py', 'execution-mcp.py', 'scientific_verified_results.py'):
    target = pathlib.Path('/opt/bionemo') / name
    shutil.copy2(source / name, target)
    py_compile.compile(str(target), doraise=True)
for name, target in {
    'seed-workbench.js': '/app/seed-hcls-workbench.js',
    'scientific-tool-options.cjs': '/opt/hcls-librechat/scientific-tool-options.cjs',
    'render-config.mjs': '/opt/hcls-librechat/render-config.mjs',
    'native_md_report.py': '/opt/bionemo/report-native-md.py',
    'demos/service.cjs': '/opt/hcls-librechat/demos/service.cjs',
    'demos/analysis.cjs': '/opt/hcls-librechat/demos/analysis.cjs',
    'demos/mcp.cjs': '/opt/hcls-librechat/demos/mcp.cjs',
    'profiles/cancer-immunology.md': '/opt/hcls-librechat/profiles/cancer-immunology.md',
}.items():
    pathlib.Path(target).parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source / name, target)
shutil.copy2('/tmp/viewer/viewer-mcp.py', '/opt/bionemo/viewer-mcp.py')
# Available for explicit activation; no external connector is enabled by the image.
shutil.copytree('/tmp/cbioportal', '/opt/hcls-librechat/plugins/cbioportal-research', dirs_exist_ok=True)
PYINSTALL
RUN --mount=type=bind,from=scientific-skills,target=/tmp/scientific-skills,ro python3 - <<'PY'
import hashlib, json, py_compile, shutil, subprocess
from pathlib import Path
source = Path('/tmp/scientific-skills')
subprocess.run(['python3', str(source / 'bundle.py'), 'verify'], check=True)
root = Path('/app/skill')
inventory = json.loads((source / 'files.sha256.json').read_bytes())
# Install the exact current portable bundle; preserve additional ClawBio skills.
for name, expected in inventory.items():
    target = root / name
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source / name, target)
    assert hashlib.sha256((root / name).read_bytes()).hexdigest() == expected, name
shutil.copy2(source / 'files.sha256.json', root / 'files.sha256.json')
profile = Path('/opt/hcls-librechat/profiles/cancer-research-instructions.md')
profile.write_bytes(Path('/app/agent-instructions.md').read_bytes() + Path('/opt/hcls-librechat/profiles/cancer-immunology.md').read_bytes())
py_compile.compile('/opt/bionemo/scientific_study.py', doraise=True)
print(json.dumps({'managed_files_verified': len(inventory), 'other_skills_preserved': True}))
PY
RUN --mount=type=bind,source=templates/hcls-librechat,target=/tmp/client,ro \
    cp /tmp/client/scripts/scientific-batch-acceptance.py /opt/bionemo/invoke-scientific-batch.py \
 && cp /tmp/client/scientific-workflow.py /tmp/client/scientific-study-worker.py /opt/bionemo/ \
 && /opt/scientific-client/bin/python /tmp/client/scripts/verify-observer-recovery.py --source /tmp/client
RUN --mount=type=bind,source=templates/hcls-librechat,target=/tmp/client,ro \
    node /tmp/client/patch-report-preview.mjs /app/client \
 && cp /tmp/client/ScientificArtifactMarkdown.test.ts /app/client/src/components/ \
 && cd /app/client \
 && NODE_ENV=test /app/node_modules/.bin/jest --runInBand --watch=false --coverage=false --forceExit \
    src/components/ScientificArtifactMarkdown.test.ts \
 && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 /app/node_modules/.bin/vite build --logLevel error \
 && node /opt/hcls-librechat/brand-client.mjs /app/client/dist /opt/hcls-librechat/assets --verify
ARG HCLS_IMAGE_REVISION=unknown
LABEL org.opencontainers.image.revision="${HCLS_IMAGE_REVISION}" \
      org.opencontainers.image.source="https://github.com/rene-tech/serverless-ai-cookbook" \
      ai.nebius.scientific.release="client-fixes-20261024" \
      ai.nebius.scientific.skills.version="2026.10.24.4" \
      ai.nebius.scientific.skills.revision="${HCLS_IMAGE_REVISION}"
