# syntax=docker/dockerfile:1.7
# Additive deliverable validation over the current BioEmu2/viewer release.
# Preserve its clients, runtimes, supervisor, provider and complete skill set.
ARG WORKBENCH_BASE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/lc@sha256:eec90d1801d76ad040453bff68d4482d2aa7d79c1928b5fa123b0976df1dd155
FROM ${WORKBENCH_BASE}
USER root
COPY templates/hcls-librechat/scientific_study.py /opt/bionemo/scientific_study.py
COPY skills/scientific-ai/scientific-batch/SKILL.md /app/skill/scientific-batch/SKILL.md
COPY skills/scientific-ai/files.sha256.json /app/skill/files.sha256.json
