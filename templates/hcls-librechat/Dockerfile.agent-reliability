# syntax=docker/dockerfile:1.7
# Additive qualification/release over the immutable shared OpenFF workbench.
ARG WORKBENCH_BASE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/lc@sha256:06d0ca2e976242c4120c4f56773359fff2b9a2464e890e262a6e3b7c5018da4d
FROM ${WORKBENCH_BASE} AS assembled
USER root
COPY templates/hcls-librechat/ /tmp/agent-reliability/
COPY skills/scientific-ai/ /tmp/core-skills/
RUN cp /tmp/agent-reliability/scientific-provider-recovery.cjs /tmp/agent-reliability/scientific-verified-delivery.cjs /tmp/agent-reliability/scientific-study-admission.cjs /tmp/agent-reliability/scientific-tool-options.cjs /tmp/agent-reliability/patch-agent-reliability.mjs /tmp/agent-reliability/patch-execution-ui.mjs /opt/hcls-librechat/ \
 && python3 /tmp/core-skills/bundle.py verify \
 && cp /tmp/core-skills/openff/SKILL.md /app/skill/openff/SKILL.md \
 && cp /tmp/core-skills/manifest.json /tmp/core-skills/files.sha256.json /app/skill/ \
 && cp /tmp/agent-reliability/execution-mcp.py /tmp/agent-reliability/scientific_verified_results.py /opt/bionemo/ \
 && cp /tmp/agent-reliability/agent-instructions.md /app/agent-instructions.md \
 && cp /tmp/agent-reliability/seed-workbench.js /app/seed-hcls-workbench.js \
 && cp /tmp/agent-reliability/ScientificExecutionOutput.tsx /tmp/agent-reliability/ScientificExecutionOutput.test.tsx /app/client/src/components/Chat/Messages/Content/ \
 && node /opt/hcls-librechat/patch-agent-reliability.mjs \
 && node /opt/hcls-librechat/patch-execution-ui.mjs \
 && node --check /app/node_modules/@librechat/agents/dist/cjs/graphs/Graph.cjs \
 && node --check /app/seed-hcls-workbench.js \
 && python3 -m py_compile /opt/bionemo/execution-mcp.py /opt/bionemo/scientific_verified_results.py
WORKDIR /app/client
RUN NODE_ENV=test /app/node_modules/.bin/jest --runInBand --watch=false --coverage=false --forceExit src/components/Chat/Messages/Content/ScientificExecutionOutput.test.tsx \
 && NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 /app/node_modules/.bin/vite build

# Stage only changed files so the final layer stays small, without hashing or
# copying the full multi-GB dependency tree on every additive release.
RUN mkdir -p /release/opt/hcls-librechat /release/opt/bionemo /release/app/skill/openff /release/app/node_modules/@librechat/agents/dist/cjs/graphs /release/app/client/src/components/Chat/Messages/Content \
 && cp /opt/hcls-librechat/scientific-provider-recovery.cjs /opt/hcls-librechat/scientific-verified-delivery.cjs /opt/hcls-librechat/scientific-study-admission.cjs /opt/hcls-librechat/scientific-tool-options.cjs /opt/hcls-librechat/patch-agent-reliability.mjs /opt/hcls-librechat/patch-execution-ui.mjs /release/opt/hcls-librechat/ \
 && cp /opt/bionemo/execution-mcp.py /opt/bionemo/scientific_verified_results.py /release/opt/bionemo/ \
 && cp /app/agent-instructions.md /app/seed-hcls-workbench.js /release/app/ \
 && cp /app/skill/openff/SKILL.md /release/app/skill/openff/SKILL.md \
 && cp /app/skill/manifest.json /app/skill/files.sha256.json /release/app/skill/ \
 && cp /app/node_modules/@librechat/agents/dist/cjs/graphs/Graph.cjs /release/app/node_modules/@librechat/agents/dist/cjs/graphs/Graph.cjs \
 && cp /app/client/src/components/Chat/Messages/Content/ToolCallInfo.tsx /app/client/src/components/Chat/Messages/Content/ScientificExecutionOutput.tsx /release/app/client/src/components/Chat/Messages/Content/ \
 && cp -a /app/client/dist /release/app/client/dist

FROM ${WORKBENCH_BASE}
USER root
COPY --from=assembled /release/ /
ARG HCLS_IMAGE_REVISION=unknown
LABEL org.opencontainers.image.revision="${HCLS_IMAGE_REVISION}" \
      org.opencontainers.image.source="https://github.com/rene-tech/serverless-ai-cookbook" \
      ai.nebius.scientific.agent-reliability.revision="${HCLS_IMAGE_REVISION}"
