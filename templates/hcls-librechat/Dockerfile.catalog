# syntax=docker/dockerfile:1.7
# Narrow discovery overlay; keep the qualified single-cell, branding and state base.
ARG WORKBENCH_BASE=cr.eu-north1.nebius.cloud/e00akg9ndpx77eaexh/lc@sha256:92b18aa638f222d1b5b53c61e3c4cad9e11e5e5abc032e856a6a8d69388086fc
FROM ${WORKBENCH_BASE} AS assembled
USER root
COPY templates/hcls-librechat/agent-instructions.md /release/app/agent-instructions.md
COPY templates/hcls-librechat/seed-workbench.js /release/app/seed-hcls-workbench.js
COPY templates/hcls-librechat/demos/service.cjs /release/opt/hcls-librechat/demos/service.cjs
COPY templates/hcls-librechat/demos/mcp.cjs /release/opt/hcls-librechat/demos/mcp.cjs
COPY skills/scientific-ai/ /release/app/skill/
RUN python3 /release/app/skill/bundle.py verify \
 && node --check /release/app/seed-hcls-workbench.js \
 && node --check /release/opt/hcls-librechat/demos/service.cjs \
 && node --check /release/opt/hcls-librechat/demos/mcp.cjs

# One added layer: do not exhaust Serverless's overlay layer headroom.
FROM ${WORKBENCH_BASE}
USER root
COPY --from=assembled /release/ /
ARG HCLS_IMAGE_REVISION=unknown
LABEL org.opencontainers.image.revision="${HCLS_IMAGE_REVISION}" \
      org.opencontainers.image.source="https://github.com/rene-tech/serverless-ai-cookbook" \
      ai.nebius.scientific.skills.version="2026.10.07.5" \
      ai.nebius.scientific.release="catalog-20261007"
