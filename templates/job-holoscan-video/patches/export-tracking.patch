+    if (!copied) return fail(holoscan::ErrorCode::kFailure, "cannot copy segmentation masks to output");
+    if (!std::ranges::all_of(host_masks, [](float x) { return std::isfinite(x); })) {
+      return fail(holoscan::ErrorCode::kFailure, "segmentation masks contain non-finite predictions");
+    }
+    for (std::size_t tool = 0; tool < kClasses; ++tool) {
