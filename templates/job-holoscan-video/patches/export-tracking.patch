+  const auto& output_dir = context.params<ToolTrackingPostprocessorParams>().output_directory;
+  if (!output_dir.empty()) {
+    if (!table_.is_open()) {
+      std::filesystem::create_directories(output_dir);
+      const auto table_path = std::filesystem::path(output_dir) / "tracking.csv";
+      const auto masks_path = std::filesystem::path(output_dir) / "masks.f32";
+      if (std::filesystem::exists(table_path) || std::filesystem::exists(masks_path)) {
+        return fail(holoscan::ErrorCode::kFailure, "tracking output already exists; choose a new run directory");
+      }
+      table_.open(table_path);
+      masks_file_.open(masks_path, std::ios::binary);
+      table_.exceptions(std::ios::badbit | std::ios::failbit);
+      masks_file_.exceptions(std::ios::badbit | std::ios::failbit);
+      table_ << "frame_index,tool_index,probability,x_normalized,y_normalized\n";
+      table_ << std::setprecision(9);
+    }
+    std::vector<float> host_masks(kClasses * kMaskPixels);
