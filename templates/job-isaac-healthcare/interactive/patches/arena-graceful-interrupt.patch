     # -- events ----------------------------------------------------------
     def _on_event(self, event: WorkflowEvent) -> None:
+        # The owner's optional readiness contract follows the generic engine
+        # lifecycle, after scene reset and actuation setup, never log timing.
+        path = os.environ.get("I4H_WORKFLOW_READY_FILE")
+        if path and event.kind == "workflow_started" and not getattr(self, "_startup_ready_written", False):
+            session_id = os.environ["I4H_WORKFLOW_READY_SESSION"]
+            fields = Path("/proc/self/stat").read_text().rsplit(")", 1)[1].split()
+            value = {"schema": "isaac-workflow-readiness/v1", "session_id": session_id,
+                     "event": event.kind, "pid": os.getpid(), "start_ticks": int(fields[19])}
+            temporary = Path(path).with_name(Path(path).name + "." + uuid.uuid4().hex + ".tmp")
+            try:
+                with temporary.open("x") as stream:
+                    json.dump(value, stream, sort_keys=True)
+                    stream.write("\n")
+                    stream.flush()
+                    os.fsync(stream.fileno())
+                os.replace(temporary, path)
+            finally:
+                temporary.unlink(missing_ok=True)
+            self._startup_ready_written = True
         logger.info("%s", event)
