{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator-approved Native target transport mappings",
  "type": "object",
  "additionalProperties": false,
  "required": ["targets", "port"],
  "properties": {
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "targets": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["region", "target", "native_endpoint", "runtime_revision"],
        "properties": {
          "region": {"type": "string", "minLength": 1},
          "runtime_revision": {"type": "string", "minLength": 1},
          "native_endpoint": {"type": "string", "pattern": "^wss://[^/?#@]+/[^?#]*$"},
          "target": {
            "type": "object", "additionalProperties": false,
            "required": ["cluster", "variant", "id", "image", "gpu_class"],
            "properties": {
              "cluster": {"type": "string", "minLength": 1},
              "variant": {"type": ["string", "null"], "minLength": 1},
              "id": {"type": "string", "minLength": 1},
              "image": {"type": "string", "pattern": "^[^\\s]+@sha256:[0-9a-f]{64}$"},
              "gpu_class": {"type": ["string", "null"], "minLength": 1}
            }
          }
        }
      }
    }
  }
}
